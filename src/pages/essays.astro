
---
import Header from "../components/Header.astro";

const entries = [
  {
    date: "OCT 2026",
    category: "ESSAYS / 001",
    title: "The Case for Wonder",
    description: "An introduction to this little corner of the internet.",
    status: "Coming soon",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Essays | Phillip Cushman</title>
  </head>
  <body>
    <Header />
      
    <main>
      <section class="intro">
        <p class="eyebrow">PERSONAL ARCHIVE / SECTION 01</p>
        <h1>Essays<span>.</span></h1>
        <p>Longer reflections on science, exploration, philosophy, literature, and the questions worth asking.</p>
      </section>

      <section class="entries">
        <p class="eyebrow">RECENT ENTRIES / 2026</p>
        {entries.map((entry) => (
          <article>
            <div class="date">{entry.date}</div>
            <div>
              <p class="eyebrow">{entry.category}</p>
              <h2>{entry.title}</h2>
              <p class="description">{entry.description}</p>
            </div>
            <div class="status">{entry.status}</div>
          </article>
        ))}
      </section>
    </main>

    <footer>
      <span>© 2026 PHILLIP CUSHMAN</span>
      <span>MADE ON EARTH. / LOOKING OUTWARD.</span>
    </footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: #F0EEE5; color: #192C43; font-family: 'DM Sans', sans-serif; }

  .topline {
    background: #192C43; color: #F0EEE5;
    padding: 12px 6%; display: flex; justify-content: space-between;
    font-size: 10px; font-weight: 700; letter-spacing: 2px;
  }

  header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 24px 6%; border-bottom: 1px solid #c8c3b5;
  }

  .logo {
    font: 700 34px 'Space Grotesk', sans-serif;
    letter-spacing: -3px; text-decoration: none; color: #192C43;
  }

  .logo span, h1 span { color: #557C9B; }

  nav { display: flex; gap: 30px; }
  nav a {
    color: #192C43; text-decoration: none;
    font-size: 12px; font-weight: 700; text-transform: uppercase;
  }
  nav a:hover { color: #557C9B; }

  .intro {
    padding: 100px 8%;
    background: linear-gradient(120deg, #F0EEE5 60%, #d7dfe0);
    border-bottom: 1px solid #c8c3b5;
  }

  .eyebrow {
    color: #557C9B; font-size: 11px;
    letter-spacing: 2px; font-weight: 700;
  }

  h1, h2 { font-family: 'Space Grotesk', sans-serif; }
  h1 {
    font-size: clamp(52px, 8vw, 110px);
    letter-spacing: -5px; margin: 20px 0;
  }

  .intro > p:last-child {
    max-width: 550px; font-size: 18px;
    line-height: 1.8; color: #536574;
  }

  .entries { padding: 80px 8% 130px; }

  article {
    display: grid; grid-template-columns: 130px 1fr 110px;
    gap: 20px; padding: 35px 0;
    border-top: 1px solid #bfc5c3;
    align-items: start;
  }

  article:last-child { border-bottom: 1px solid #bfc5c3; }

  .date, .status {
    font-size: 11px; letter-spacing: 1px;
    color: #557C9B; font-weight: 700;
  }

  h2 { font-size: 32px; margin: 10px 0; }
  .description { color: #687681; line-height: 1.7; }

  footer {
    background: #192C43; color: #F0EEE5;
    display: flex; justify-content: space-between;
    padding: 30px 6%; font-size: 10px; letter-spacing: 1.5px;
  }

  @media(max-width: 700px) {
    header { flex-direction: column; gap: 20px; }
    nav { flex-wrap: wrap; justify-content: center; gap: 15px; }
    .topline { font-size: 8px; }
    .intro { padding: 70px 7%; }
    article { grid-template-columns: 1fr; gap: 8px; }
    .entries { padding: 60px 7%; }
    footer { flex-direction: column; gap: 12px; }
  }
</style>
