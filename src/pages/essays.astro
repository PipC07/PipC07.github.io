
---
import Header from "../components/Header.astro";
import { getCollection } from "astro:content";

const essays = (await getCollection("essays"))
  .filter((essay) => !essay.data.draft)
  .sort(
    (a, b) =>
      b.data.date.getTime() - a.data.date.getTime()
  );
  function formatDate(date: Date) {
  const day = date.getUTCDate();
  const suffix =
    day % 100 >= 11 && day % 100 <= 13
      ? "th"
      : day % 10 === 1 ? "st"
      : day % 10 === 2 ? "nd"
      : day % 10 === 3 ? "rd"
      : "th";

  const month = date.toLocaleDateString("en-US", {
    month: "long",
    timeZone: "UTC",
  });

  return `${month} ${day}${suffix}, ${date.getUTCFullYear()}`;
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Essays | Phillip Cushman</title>
    <meta
      name="description"
      content="Essays and writing by Phillip Cushman."
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="intro">
        <p class="eyebrow">PERSONAL ARCHIVE / SECTION 01</p>
        <h1>Essays<span>.</span></h1>
        <p class="subtitle">
          Longer reflections on science, exploration,
          philosophy, literature, and the questions worth asking.
        </p>
      </section>

      <section class="entries">
        <p class="eyebrow">PUBLISHED WRITING / ARCHIVE</p>

        {essays.length === 0 ? (
          <p class="empty">
            No essays have been published yet.
          </p>
        ) : (
          essays.map((essay, index) => (
            <article class="entry">
              <div class="date">
                {formatDate(essay.data.date)}
              </div>

              <div class="entry-content">
                <p class="eyebrow">
                  ESSAYS / {String(essays.length - index).padStart(3, "0")}
                </p>

                <h2>
                  <a href={`/essays/${essay.id}/`}>
                    {essay.data.title}
                  </a>
                </h2>

                <p class="description">
                  {essay.data.description}
                </p>
              </div>

              <span class="arrow">↗</span>
            </article>
          ))
        )}
      </section>
    </main>

    <footer>
      <span>© 2026 PHILLIP CUSHMAN</span>
      <span>MADE ON EARTH. / LOOKING OUTWARD.</span>
    </footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #F0EEE5;
    color: #192C43;
    font-family: 'DM Sans', sans-serif;
  }

  .intro {
    padding: 100px 8%;
    background: linear-gradient(
      120deg,
      #F0EEE5 60%,
      #d7dfe0
    );
    border-bottom: 1px solid #c8c3b5;
  }

  .eyebrow {
    color: #557C9B;
    font-size: 11px;
    letter-spacing: 2px;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1, h2 {
    font-family: 'Space Grotesk', sans-serif;
  }

  h1 {
    font-size: clamp(52px, 8vw, 110px);
    letter-spacing: -5px;
    margin: 20px 0;
  }

  h1 span {
    color: #557C9B;
  }

  .subtitle {
    max-width: 550px;
    font-size: 18px;
    line-height: 1.8;
    color: #536574;
  }

  .entries {
    padding: 80px 8% 130px;
    min-height: 360px;
  }

  .entry {
    display: grid;
    grid-template-columns: 130px 1fr 30px;
    gap: 20px;
    padding: 35px 0;
    border-top: 1px solid #bfc5c3;
    align-items: start;
  }

  .entry:last-child {
    border-bottom: 1px solid #bfc5c3;
  }

  .date {
    font-size: 11px;
    letter-spacing: 1px;
    color: #557C9B;
    font-weight: 700;
  }

  h2 {
    font-size: 32px;
    margin: 10px 0;
  }

  h2 a {
    color: #192C43;
    text-decoration: none;
    transition: color 0.2s;
  }

  h2 a:hover {
    color: #557C9B;
  }

  .description {
    color: #687681;
    line-height: 1.7;
  }

  .arrow {
    color: #557C9B;
    font-size: 22px;
  }

  .empty {
    color: #687681;
    margin-top: 35px;
  }

  footer {
    background: #192C43;
    color: #F0EEE5;
    display: flex;
    justify-content: space-between;
    padding: 30px 6%;
    font-size: 10px;
    letter-spacing: 1.5px;
  }

  @media (max-width: 700px) {
    .intro {
      padding: 70px 7%;
    }

    .entry {
      grid-template-columns: 1fr 24px;
      gap: 8px;
    }

    .date {
      grid-column: 1 / -1;
    }

    .entries {
      padding: 60px 7%;
    }

    footer {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
