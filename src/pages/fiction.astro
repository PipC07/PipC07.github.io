
---
import Header from "../components/Header.astro";
import { getCollection } from "astro:content";

const stories = (await getCollection("fiction"))
  .filter((story) => !story.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(date: Date) {
  const day = date.getUTCDate();
  const suffix =
    day % 100 >= 11 && day % 100 <= 13 ? "th"
    : day % 10 === 1 ? "st"
    : day % 10 === 2 ? "nd"
    : day % 10 === 3 ? "rd" : "th";

  const month = date.toLocaleDateString("en-US", {
    month: "long",
    timeZone: "UTC",
  });

  return `${month} ${day}${suffix}, ${date.getUTCFullYear()}`;
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fiction | Phillip Cushman</title>
    <meta name="description" content="Fiction, stories, and imagined worlds by Phillip Cushman." />
  </head>

  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">PERSONAL ARCHIVE / FICTION</p>
          <h1>Other<br /><em>worlds.</em></h1>

          <p class="subtitle">
            Fiction, imagined futures, and stories about the unknown.
            Exploring not just where humanity might go, but what
            we might become along the way.
          </p>

          <a href="#projects" class="explore">
            EXPLORE THE STORIES &nbsp; ↗
          </a>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="starfield"></div>
          <div class="world"></div>
          <div class="horizon"></div>
          <span class="figure-label">FIG. 02 / WORLDS UNKNOWN</span>
        </div>
      </section>

      <div class="divider-band">
        <span>FICTION</span>
        <span>✳</span>
        <span>IMAGINATION</span>
        <span>✳</span>
        <span>DISCOVERY</span>
      </div>

      <section class="projects" id="projects">
        <div class="section-heading">
          <div>
            <p class="eyebrow">PUBLISHED FICTION / ARCHIVE</p>
            <h2>Stories from the archive<span>.</span></h2>
          </div>
          <span class="section-code">FICTION / 2026—</span>
        </div>

        {stories.length === 0 ? (
          <div class="empty">
            <h3>Stories are on their way.</h3>
            <p>
              This archive is still taking shape. New fiction will
              appear here when it's ready to share.
            </p>
          </div>
        ) : (
          stories.map((story, index) => (
            <article class="project">
              <span class="project-number">
                {String(stories.length - index).padStart(3, "0")}
              </span>

              <div class="project-content">
                <p class="eyebrow">
                  FICTION / {formatDate(story.data.date)}
                </p>

                <h3>
                  <a href={`/fiction/${story.id}/`}>
                    {story.data.title}
                  </a>
                </h3>

                <p>{story.data.description}</p>

                <a class="read-link" href={`/fiction/${story.id}/`}>
                  READ STORY ↗
                </a>
              </div>

              <span class="project-symbol">✳</span>
            </article>
          ))
        )}
      </section>

      <section class="closing">
        <p class="eyebrow">A NOTE ON STORYTELLING</p>
        <h2>There's always<br />more to <em>discover.</em></h2>
        <p>
          The best stories don't just take us somewhere new.
          They leave us with questions worth bringing home.
        </p>
      </section>
    </main>

    <footer>
      <span>© 2026 PHILLIP CUSHMAN</span>
      <span>MADE ON EARTH. / LOOKING OUTWARD.</span>
    </footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    background: #F0EEE5;
    color: #192C43;
    font-family: 'DM Sans', sans-serif;
  }

  h1, h2, h3 { font-family: 'Space Grotesk', sans-serif; }

  .eyebrow {
    color: #87A9C1;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 620px;
    background: #192C43;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 90px 10% 90px 12%;
    color: #F0EEE5;
  }

  h1 {
    font-size: clamp(68px, 8vw, 120px);
    letter-spacing: -7px;
    line-height: 0.95;
    margin: 28px 0;
  }

  h1 em, .closing em {
    color: #A9BDC8;
    font-style: normal;
  }

  .subtitle {
    max-width: 460px;
    color: #C0CAD2;
    font-size: 17px;
    line-height: 1.9;
  }

  .explore {
    width: fit-content;
    color: #F0EEE5;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    border-bottom: 2px solid #87A9C1;
    padding-bottom: 9px;
    margin-top: 30px;
  }

  .hero-visual {
    position: relative;
    overflow: hidden;
    min-height: 500px;
    background: radial-gradient(
      ellipse at 50% 65%,
      #34556E 0%,
      #192C43 45%,
      #091522 100%
    );
  }

  .starfield {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(2px 2px at 15% 20%, #fff 98%, transparent),
      radial-gradient(2px 2px at 75% 15%, #fff 98%, transparent),
      radial-gradient(1px 1px at 33% 49%, #fff 98%, transparent),
      radial-gradient(2px 2px at 84% 62%, #fff 98%, transparent),
      radial-gradient(1px 1px at 55% 30%, #fff 98%, transparent),
      radial-gradient(1px 1px at 19% 78%, #fff 98%, transparent);
    opacity: 0.75;
  }

  .world {
    position: absolute;
    width: 440px;
    height: 440px;
    border-radius: 50%;
    top: 48%;
    left: 53%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle at 30% 25%,
      #B9D1DE,
      #62849A 35%,
      #304A61 65%,
      #101E30 90%
    );
    box-shadow: 30px 35px 95px #07111c;
  }

  .horizon {
    position: absolute;
    width: 150%;
    height: 180px;
    border-radius: 50%;
    bottom: -130px;
    left: -25%;
    background: #0C1D2B;
    box-shadow: 0 -10px 55px #638CA055;
  }

  .figure-label {
    position: absolute;
    bottom: 25px;
    left: 30px;
    color: #CFD8DC;
    font-size: 10px;
    letter-spacing: 2px;
  }

  .divider-band {
    display: flex;
    justify-content: space-around;
    padding: 20px;
    background: #557C9B;
    color: white;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
  }

  .projects {
    padding: 100px 8% 110px;
    min-height: 400px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 50px;
  }

  .section-heading h2 {
    font-size: clamp(38px, 4vw, 60px);
    margin: 12px 0;
    letter-spacing: -3px;
  }

  .section-heading h2 span { color: #557C9B; }

  .section-code {
    font-size: 11px;
    color: #71808C;
    letter-spacing: 1.5px;
  }

  .project {
    display: grid;
    grid-template-columns: 80px 1fr 40px;
    padding: 35px 0;
    border-top: 1px solid #BFC5C3;
  }

  .project:last-of-type {
    border-bottom: 1px solid #BFC5C3;
  }

  .project-number {
    font: 700 24px 'Space Grotesk', sans-serif;
    color: #557C9B;
  }

  .project h3 {
    font-size: clamp(28px, 3vw, 42px);
    margin: 12px 0;
    letter-spacing: -1.5px;
  }

  .project h3 a {
    color: #192C43;
    text-decoration: none;
  }

  .project h3 a:hover { color: #557C9B; }

  .project-content > p:not(.eyebrow) {
    max-width: 650px;
    color: #647481;
    font-size: 16px;
    line-height: 1.8;
  }

  .projects .eyebrow { color: #557C9B; }

  .read-link {
    display: inline-block;
    margin-top: 15px;
    padding-bottom: 8px;
    border-bottom: 2px solid #87A9C1;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #557C9B;
  }

  .project-symbol {
    color: #557C9B;
    font-size: 26px;
  }

  .empty {
    padding: 50px 0;
    border-top: 1px solid #BFC5C3;
    border-bottom: 1px solid #BFC5C3;
  }

  .empty h3 { font-size: 28px; }
  .empty p { color: #647481; line-height: 1.8; }

  .closing {
    padding: 100px 8%;
    background: #192C43;
    color: #F0EEE5;
  }

  .closing h2 {
    font-size: clamp(48px, 6vw, 86px);
    line-height: 1.05;
    letter-spacing: -4px;
    margin: 20px 0;
  }

  .closing > p:last-child {
    max-width: 520px;
    color: #B8C8D3;
    line-height: 1.9;
    font-size: 17px;
  }

  footer {
    display: flex;
    justify-content: space-between;
    background: #0D1D2D;
    color: #D2DCE1;
    padding: 30px 6%;
    font-size: 10px;
    letter-spacing: 1.5px;
  }

  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; }
    .hero-content { padding: 80px 7%; }
    h1 { letter-spacing: -4px; }
    .hero-visual { min-height: 380px; }
    .world { width: 300px; height: 300px; }
    .divider-band { flex-wrap: wrap; gap: 15px; font-size: 9px; }
    .projects { padding: 70px 7%; }
    .section-heading { align-items: start; gap: 15px; }
    .section-code { display: none; }
    .project { grid-template-columns: 40px 1fr; }
    .project-symbol { display: none; }
    .closing { padding: 80px 7%; }
    footer { flex-direction: column; gap: 15px; }
  }
</style>
