
---
import Header from "../components/Header.astro";

const projects = [
  {
    number: "01",
    category: "NOVEL / WORK IN PROGRESS",
    title: "An Unfinished Universe",
    description:
      "A story of planetary engineering, distant worlds, and the consequences of reshaping nature. Set centuries into humanity's future.",
    status: "IN DEVELOPMENT",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Fiction, stories, and imagined worlds by Phillip Cushman." />
    <title>Fiction | Phillip Cushman</title>
  </head>

  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">PERSONAL ARCHIVE / SECTION 03</p>

          <h1>Other<br /><em>worlds.</em></h1>

          <p class="subtitle">
            Fiction, imagined futures, and stories about the unknown.
            Exploring not just where humanity might go, but what
            we might become along the way.
          </p>

          <a href="#projects" class="explore">
            EXPLORE THE STORIES &nbsp; ↗
          </a>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="starfield"></div>
          <div class="world"></div>
          <div class="horizon"></div>
          <span class="figure-label">FIG. 02 / WORLDS UNKNOWN</span>
        </div>
      </section>

      <div class="divider-band">
        <span>FICTION</span>
        <span>✳</span>
        <span>IMAGINATION</span>
        <span>✳</span>
        <span>DISCOVERY</span>
      </div>

      <section class="projects" id="projects">
        <div class="section-heading">
          <div>
            <p class="eyebrow">WORKS / 2026—</p>
            <h2>Stories in progress<span>.</span></h2>
          </div>
          <span class="section-code">ARCHIVE / F-001</span>
        </div>

        {projects.map((project) => (
          <article class="project">
            <span class="project-number">{project.number}</span>

            <div class="project-content">
              <p class="eyebrow">{project.category}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <span class="status">{project.status}</span>
            </div>

            <span class="project-symbol">✳</span>
          </article>
        ))}

        <p class="footnote">
          Stories are currently being developed. More will appear here
          as they're ready to share.
        </p>
      </section>

      <section class="closing">
        <p class="eyebrow">A NOTE ON STORYTELLING</p>
        <h2>There's always<br />more to <em>discover.</em></h2>
        <p>
          The best stories don't just take us somewhere new.
          They leave us with questions worth bringing home.
        </p>
      </section>
    </main>

    <footer>
      <span>© 2026 PHILLIP CUSHMAN</span>
      <span>MADE ON EARTH. / LOOKING OUTWARD.</span>
    </footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #F0EEE5;
    color: #192C43;
    font-family: 'DM Sans', sans-serif;
  }

  .topline {
    display: flex;
    justify-content: space-between;
    background: #192C43;
    color: #F0EEE5;
    padding: 11px 6%;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 6%;
    border-bottom: 1px solid #c8c3b5;
  }

  .logo {
    color: #192C43;
    font: 700 34px 'Space Grotesk', sans-serif;
    letter-spacing: -3px;
    text-decoration: none;
  }

  .logo span {
    color: #557C9B;
  }

  nav {
    display: flex;
    gap: 30px;
  }

  nav a {
    color: #192C43;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  nav a:hover,
  nav a.active {
    color: #557C9B;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 620px;
    background: #192C43;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 90px 10% 90px 12%;
    color: #F0EEE5;
  }

  .eyebrow {
    color: #87A9C1;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  h1, h2, h3 {
    font-family: 'Space Grotesk', sans-serif;
  }

  h1 {
    font-size: clamp(68px, 8vw, 120px);
    letter-spacing: -7px;
    line-height: 0.95;
    margin: 28px 0;
  }

  h1 em, h2 em {
    color: #A9BDC8;
    font-style: normal;
  }

  .subtitle {
    max-width: 460px;
    color: #C0CAD2;
    font-size: 17px;
    line-height: 1.9;
  }

  .explore {
    width: fit-content;
    color: #F0EEE5;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    border-bottom: 2px solid #87A9C1;
    padding-bottom: 9px;
    margin-top: 30px;
  }

  .hero-visual {
    position: relative;
    overflow: hidden;
    min-height: 500px;
    background: radial-gradient(
      ellipse at 50% 65%,
      #34556E 0%,
      #192C43 45%,
      #091522 100%
    );
  }

  .starfield {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(2px 2px at 15% 20%, #fff 98%, transparent),
      radial-gradient(2px 2px at 75% 15%, #fff 98%, transparent),
      radial-gradient(1px 1px at 33% 49%, #fff 98%, transparent),
      radial-gradient(2px 2px at 84% 62%, #fff 98%, transparent),
      radial-gradient(1px 1px at 55% 30%, #fff 98%, transparent),
      radial-gradient(1px 1px at 19% 78%, #fff 98%, transparent);
    opacity: 0.75;
  }

  .world {
    position: absolute;
    width: 440px;
    height: 440px;
    border-radius: 50%;
    top: 48%;
    left: 53%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle at 30% 25%,
      #B9D1DE,
      #62849A 35%,
      #304A61 65%,
      #101E30 90%
    );
    box-shadow: 30px 35px 95px #07111c;
  }

  .horizon {
    position: absolute;
    width: 150%;
    height: 180px;
    border-radius: 50%;
    bottom: -130px;
    left: -25%;
    background: #0C1D2B;
    box-shadow: 0 -10px 55px #638CA055;
  }

  .figure-label {
    position: absolute;
    bottom: 25px;
    left: 30px;
    color: #CFD8DC;
    font-size: 10px;
    letter-spacing: 2px;
  }

  .divider-band {
    display: flex;
    justify-content: space-around;
    padding: 20px;
    background: #557C9B;
    color: white;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
  }

  .projects {
    padding: 100px 8% 110px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 50px;
  }

  .section-heading h2 {
    font-size: clamp(38px, 4vw, 60px);
    margin: 12px 0;
    letter-spacing: -3px;
  }

  .section-heading h2 span {
    color: #557C9B;
  }

  .section-code {
    font-size: 11px;
    color: #71808C;
    letter-spacing: 1.5px;
  }

  .project {
    display: grid;
    grid-template-columns: 80px 1fr 40px;
    padding: 35px 0;
    border-top: 1px solid #BFC5C3;
  }

  .project:last-of-type {
    border-bottom: 1px solid #BFC5C3;
  }

  .project-number {
    font: 700 24px 'Space Grotesk', sans-serif;
    color: #557C9B;
  }

  .project h3 {
    font-size: clamp(28px, 3vw, 42px);
    margin: 12px 0;
    letter-spacing: -1.5px;
  }

  .project-content > p:not(.eyebrow) {
    max-width: 650px;
    color: #647481;
    font-size: 16px;
    line-height: 1.8;
  }

  .status {
    display: inline-block;
    margin-top: 15px;
    padding: 10px 14px;
    border: 1px solid #9EAFBD;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #557C9B;
  }

  .project-symbol {
    color: #557C9B;
    font-size: 26px;
  }

  .footnote {
    color: #71808C;
    font-size: 13px;
    margin-top: 30px;
  }

  .closing {
    padding: 100px 8%;
    background: #192C43;
    color: #F0EEE5;
  }

  .closing h2 {
    font-size: clamp(48px, 6vw, 86px);
    line-height: 1.05;
    letter-spacing: -4px;
    margin: 20px 0;
  }

  .closing > p:last-child {
    max-width: 520px;
    color: #B8C8D3;
    line-height: 1.9;
    font-size: 17px;
  }

  footer {
    display: flex;
    justify-content: space-between;
    background: #0D1D2D;
    color: #D2DCE1;
    padding: 30px 6%;
    font-size: 10px;
    letter-spacing: 1.5px;
  }

  @media (max-width: 760px) {
    .topline { font-size: 8px; gap: 12px; }
    header { flex-direction: column; gap: 20px; }
    nav { flex-wrap: wrap; justify-content: center; gap: 15px; }
    nav a { font-size: 10px; }
    .hero { grid-template-columns: 1fr; }
    .hero-content { padding: 80px 7%; }
    h1 { letter-spacing: -4px; }
    .hero-visual { min-height: 380px; }
    .world { width: 300px; height: 300px; }
    .divider-band { flex-wrap: wrap; gap: 15px; font-size: 9px; }
    .projects { padding: 70px 7%; }
    .section-heading { align-items: start; gap: 15px; }
    .section-code { display: none; }
    .project { grid-template-columns: 40px 1fr; }
    .project-symbol { display: none; }
    .closing { padding: 80px 7%; }
    footer { flex-direction: column; gap: 15px; }
  }
</style>
